<?xml version="1.0"?>
<!--
  ArduPlane bindings for PteroSimAircrafts' advanced_plane (which ships PX4 rows only).
  ArduPlane's default outputs: SERVO1 aileron, SERVO2 elevator, SERVO3 throttle, SERVO4 rudder.
  Signs from its Aero.xml, checked open-loop: servo-0 +1 rolls left, servo-1 +1 rolls right,
  servo-2 +1 pitches nose up, servo-3 +1 yaws right. ArduPlane's aileron, elevator and rudder
  above 1500 are roll right, nose up and yaw right, so only servo-0 is inverted. Property rows
  are not mirrored, so no SERVOn_REVERSED is needed. servo-4/5 (flaps) are not used by its
  Aero.xml and are left unbound.
-->
<control_bindings stack="ArduPilot">
  <binding stack="ArduPilot" channel="0" property="fcs/servo-0-cmd-norm" in="-1 1" out="-1 1" invert="1" label="left aileron"/>
  <binding stack="ArduPilot" channel="0" property="fcs/servo-1-cmd-norm" in="-1 1" out="-1 1" label="right aileron"/>
  <binding stack="ArduPilot" channel="1" property="fcs/servo-2-cmd-norm" in="-1 1" out="-1 1" label="elevator"/>
  <binding stack="ArduPilot" channel="2" type="Motor" index="0" in="0 1" out="0 1" label="pusher"/>
  <binding stack="ArduPilot" channel="3" property="fcs/servo-3-cmd-norm" in="-1 1" out="-1 1" label="rudder"/>
</control_bindings>
