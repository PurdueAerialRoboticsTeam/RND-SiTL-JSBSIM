<?xml version="1.0"?>
<!--
  Flight controls. Every surface and gear servo has its own input, bound to its own servo output
  in Controls.xml. Sign convention for every surface: +1 = trailing edge down.

    fcs/aileron-left-cmd-norm      -1..1   ±20 deg   SERVO1
    fcs/aileron-right-cmd-norm     -1..1   ±20 deg   SERVO2
    fcs/ruddervator-left-cmd-norm  -1..1   ±30 deg   SERVO4
    fcs/ruddervator-right-cmd-norm -1..1   ±30 deg   SERVO5
    fcs/flap-left-cmd-norm          0..1   0..30 deg SERVO6
    fcs/flap-right-cmd-norm         0..1   0..30 deg SERVO7
    fcs/spoiler-left-cmd-norm       0..1   stowed..fully deployed  SERVO8
    fcs/spoiler-right-cmd-norm      0..1                           SERVO9
    fcs/gear-nose-cmd-norm          0..1   0 = retracted, 1 = down SERVO10
    fcs/gear-main-cmd-norm          0..1   both main wheels         SERVO11
  Read directly by JSBSim, no channel here:
    fcs/steer-cmd-norm             -1..1   nose wheel ±20 deg (Gear.xml)  SERVO12
    fcs/left/right-brake-cmd-norm   0..1   main wheel brakes              SERVO13
    fcs/edf-throttle-cmd-norm       0..1   Systems/edf.xml                SERVO3

  Servo speed is the bridge's servo lag on each Controls.xml row, so a gear leg moves exactly as
  its retract servo's PWM moves. PLACEHOLDERS: the throws (±20, ±30, 30 deg).
-->
<flight_control name="template">

  <property value="0">fcs/aileron-left-cmd-norm</property>
  <property value="0">fcs/aileron-right-cmd-norm</property>
  <property value="0">fcs/ruddervator-left-cmd-norm</property>
  <property value="0">fcs/ruddervator-right-cmd-norm</property>
  <property value="0">fcs/flap-left-cmd-norm</property>
  <property value="0">fcs/flap-right-cmd-norm</property>
  <property value="0">fcs/spoiler-left-cmd-norm</property>
  <property value="0">fcs/spoiler-right-cmd-norm</property>
  <property value="1">fcs/gear-nose-cmd-norm</property>
  <property value="1">fcs/gear-main-cmd-norm</property>
  <property value="0">fcs/edf-throttle-cmd-norm</property>

  <!-- Model scale factors for robustness sweeps (bridge option scale/...=VALUE); 1 = as modelled. -->
  <property value="1">scale/lift</property>
  <property value="1">scale/drag</property>
  <property value="1">scale/roll-power</property>
  <property value="1">scale/pitch-power</property>
  <property value="1">scale/yaw-power</property>
  <property value="1">scale/roll-damping</property>
  <property value="1">scale/pitch-damping</property>
  <property value="1">scale/yaw-damping</property>

  <channel name="Ailerons">
    <aerosurface_scale name="Left aileron">
      <input>fcs/aileron-left-cmd-norm</input>
      <domain> <min> -1 </min> <max> 1 </max> </domain>
      <range> <min> -0.3491 </min> <max> 0.3491 </max> </range>
      <output>fcs/aileron-left-pos-rad</output>
    </aerosurface_scale>
    <aerosurface_scale name="Right aileron">
      <input>fcs/aileron-right-cmd-norm</input>
      <domain> <min> -1 </min> <max> 1 </max> </domain>
      <range> <min> -0.3491 </min> <max> 0.3491 </max> </range>
      <output>fcs/aileron-right-pos-rad</output>
    </aerosurface_scale>
  </channel>

  <channel name="V-tail">
    <aerosurface_scale name="Left ruddervator">
      <input>fcs/ruddervator-left-cmd-norm</input>
      <domain> <min> -1 </min> <max> 1 </max> </domain>
      <range> <min> -0.5236 </min> <max> 0.5236 </max> </range>
      <output>fcs/ruddervator-left-pos-rad</output>
    </aerosurface_scale>
    <aerosurface_scale name="Right ruddervator">
      <input>fcs/ruddervator-right-cmd-norm</input>
      <domain> <min> -1 </min> <max> 1 </max> </domain>
      <range> <min> -0.5236 </min> <max> 0.5236 </max> </range>
      <output>fcs/ruddervator-right-pos-rad</output>
    </aerosurface_scale>
  </channel>

  <channel name="Flaps">
    <pure_gain name="Left flap">
      <input>fcs/flap-left-cmd-norm</input>
      <gain> 0.5236 </gain>
      <clipto> <min> 0 </min> <max> 0.5236 </max> </clipto>
      <output>fcs/flap-left-pos-rad</output>
    </pure_gain>
    <pure_gain name="Right flap">
      <input>fcs/flap-right-cmd-norm</input>
      <gain> 0.5236 </gain>
      <clipto> <min> 0 </min> <max> 0.5236 </max> </clipto>
      <output>fcs/flap-right-pos-rad</output>
    </pure_gain>
  </channel>

  <channel name="Spoilers">
    <pure_gain name="Left spoiler">
      <input>fcs/spoiler-left-cmd-norm</input>
      <gain> 1 </gain>
      <clipto> <min> 0 </min> <max> 1 </max> </clipto>
      <output>fcs/spoiler-left-pos-norm</output>
    </pure_gain>
    <pure_gain name="Right spoiler">
      <input>fcs/spoiler-right-cmd-norm</input>
      <gain> 1 </gain>
      <clipto> <min> 0 </min> <max> 1 </max> </clipto>
      <output>fcs/spoiler-right-pos-norm</output>
    </pure_gain>
  </channel>

  <!-- Gear units are numbered in Gear.xml order: 0 nose, 1 left main, 2 right main.
       gear/gear-pos-norm is left at 1 so JSBSim uses these per-unit positions. -->
  <channel name="Landing gear">
    <pure_gain name="Nose gear">
      <input>fcs/gear-nose-cmd-norm</input>
      <gain> 1 </gain>
      <clipto> <min> 0 </min> <max> 1 </max> </clipto>
      <output>gear/unit[0]/pos-norm</output>
    </pure_gain>
    <pure_gain name="Main gear">
      <input>fcs/gear-main-cmd-norm</input>
      <gain> 1 </gain>
      <clipto> <min> 0 </min> <max> 1 </max> </clipto>
      <output>gear/unit[1]/pos-norm</output>
      <output>gear/unit[2]/pos-norm</output>
    </pure_gain>
  </channel>

</flight_control>
