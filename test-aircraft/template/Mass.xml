<?xml version="1.0"?>
<!--
  Mass and inertia. PLACEHOLDERS: replace with CAD mass properties, then with a weigh-and-balance
  and an inertia swing test of the built aircraft.

  Total 2.5 kg: airframe 1.7 kg (everything except battery and payload) + battery 0.6 kg +
  payload 0.2 kg. The airframe CG is placed so the total CG lands on AERORP (x = 0.50 m).

  ixx, iyy, izz, ixz are the AIRFRAME ONLY (emptywt), about the AIRFRAME'S OWN CG (the CG
  location below), not about the loaded aircraft's CG. Every step JSBSim builds the loaded
  aircraft's inertia from them (FGMassBalance::Run): it moves them to the current total CG
  (parallel-axis theorem), then adds each point mass as mass x distance squared from that CG,
  plus the point mass's own inertia if it has one. So moving or reweighing the battery or
  payload changes the inertia correctly without editing these numbers. Here the battery and
  payload sit near the CG on the centreline and add only about 0.002 kg*m2 to iyy and izz.

  A point mass is a dot unless given its own inertia: either its own <ixx>/<iyy>/<izz> inside
  <pointmass> (use this for a battery, from CAD), or a <form shape="cylinder|tube|sphere|ball">
  with <radius> and <length>.

  From CAD: export the airframe without battery and payload, mass properties about its own CG.

  Products of inertia (ixz): negated_crossproduct_inertia="false", JSBSim's recommended setting
  and the usual flight-dynamics convention, means ixz is entered as the plain integral
  +integral(x * z * dm) about the CG, in the structural axes (x aft, z up). The product x*z is the
  same in body axes (x forward, z down), so the textbook / CAD Ixz goes in unchanged, as long as
  the CAD tool reports the plain integral (not its negative) and both CAD axes are flipped
  together. Mass aft and high (the V-tail) or forward and low (a battery under the nose) makes
  ixz positive; aft and low or forward and high makes it negative.
  At run time, the property inertia/ixz-slugs_ft2 is the inertia-matrix element J(1,3), which is
  the NEGATIVE of Ixz: entering +0.01 here shows -0.01 there (checked in JSBSim 1.3.3).
-->
<mass_balance negated_crossproduct_inertia="false">
  <ixx unit="KG*M2"> 0.15 </ixx>          <!-- roll inertia: resistance to rolling (about the fuselage axis) -->
  <iyy unit="KG*M2"> 0.20 </iyy>          <!-- pitch inertia: resistance to pitching nose up/down -->
  <izz unit="KG*M2"> 0.33 </izz>          <!-- yaw inertia: resistance to yawing nose left/right -->
  <ixz unit="KG*M2"> 0.00 </ixz>          <!-- roll-yaw product of inertia, +integral(x*z*dm) (diagonal mass spread in side view) -->
  <emptywt unit="KG"> 1.70 </emptywt>     <!-- airframe mass, without the point masses below -->
  <location name="CG" unit="M">           <!-- airframe centre of gravity, metres from the nose -->
    <x> 0.512 </x>                        <!-- aft of the nose -->
    <y> 0.000 </y>                        <!-- right of the centreline -->
    <z> 0.000 </z>                        <!-- above the fuselage reference line -->
  </location>
  <pointmass name="BATTERY">
    <weight unit="KG"> 0.60 </weight>     <!-- battery mass -->
    <location name="POINTMASS" unit="M">  <!-- battery position: x aft, y right, z up -->
      <x> 0.45 </x>
      <y> 0.00 </y>
      <z> 0.00 </z>
    </location>
  </pointmass>
  <pointmass name="PAYLOAD">
    <weight unit="KG"> 0.20 </weight>     <!-- payload mass -->
    <location name="POINTMASS" unit="M">  <!-- payload position: x aft, y right, z up -->
      <x> 0.55 </x>
      <y> 0.00 </y>
      <z> -0.02 </z>
    </location>
  </pointmass>
</mass_balance>
